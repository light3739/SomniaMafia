# --- REDIS CONFIGURATION ---
# Use an Upstash Redis URL or a local Redis instance
# Format: redis://[:password]@host:port
REDIS_URL=redis://127.0.0.1:6379

# --- NEXT PUBLIC CONFIG (Optional) ---
# Active network for frontend contract config: avalanche_fuji | somnia_testnet
NEXT_PUBLIC_ACTIVE_NETWORK=somnia_testnet
# NEXT_PUBLIC_MAFIA_CONTRACT_ADDRESS=0x...
# NEXT_PUBLIC_VERIFIER_CONTRACT_ADDRESS=0x...

# --- VOICE CHAT (Daily.co) ---
# Daily.co API key (https://dashboard.daily.co/developers) — server-only
DAILY_API_KEY=your_daily_api_key_here
# Your Daily.co subdomain (rooms resolve to https://<domain>.daily.co/<room>)
NEXT_PUBLIC_DAILY_DOMAIN=your_subdomain

# --- VOICE CHAT (LiveKit) — Rollback only, unused while Daily is active ---
# Kept populated for quick rollback to self-hosted LiveKit stack at ops/livekit-turn-443/
# NEXT_PUBLIC_LIVEKIT_URL=wss://livekit.mafiaonchain.live
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# --- AGENT MODE ---
# Sponsor / deployer key — pays gas for contract deploys + funds agent wallets.
PRIVATE_KEY=0x...

# Private key of the wallet the LLM agent uses to sign on-chain actions
# (joinRoom, vote, night action). Must be a live player in the target room.
LLM_AGENT_PRIVATE_KEY=0x...
