NODE_ENV=production
PORT=3000

# Frontend public URLs (also baked at build time — must match CI workflow env)
NEXT_PUBLIC_GM_SERVER_URL=https://gm.mafiaonchain.live
NEXT_PUBLIC_DAILY_DOMAIN=your_daily_subdomain
NEXT_PUBLIC_ACTIVE_NETWORK=somnia_mainnet

# Daily.co server-only API key for /api/token (https://dashboard.daily.co/developers)
DAILY_API_KEY=replace-with-daily-api-key

# Backend storage for Next.js API routes
REDIS_URL=redis://redis:6379

# Optional
# NEXT_PUBLIC_MAFIA_DIAMOND=0x...
