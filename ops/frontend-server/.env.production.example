NODE_ENV=production
PORT=3000

# Frontend public URLs
NEXT_PUBLIC_GM_SERVER_URL=https://gm.mafiaonchain.live
NEXT_PUBLIC_LIVEKIT_URL=https://livekit.mafiaonchain.live
NEXT_PUBLIC_ACTIVE_NETWORK=avalanche_fuji

# LiveKit server credentials for /api/token
# Must match keys configured in livekit server (livekit.yaml -> keys)
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-livekit-secret

# Backend storage for Next.js API routes
REDIS_URL=redis://redis:6379

# Optional/override if needed
# NEXT_PUBLIC_MAFIA_ADDRESS=0x...